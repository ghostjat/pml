{
    "$schema": "https://phpbench.readthedocs.io/en/latest/phpbench.schema.json",
    "runner.bootstrap": "vendor/autoload.php",
    "runner.path": "benchmarks",
    "runner.php_config": {
        "memory_limit": "2G",
        "opcache.enable_cli": "1",
        "opcache.jit": "1255",
        "opcache.jit_buffer_size": "256M"
    },
    "report.generators": {
        "tensor_profile": {
            "generator": "table",
            "sort": {"subject": "asc"},
            "cols": [
                "benchmark", "subject", "set", "revs", "its", "mem_peak", "mode", "rstdev"
            ]
        }
    }
}
{
    "name": "ghostjat/pml",
    "description": "High-performance Tensor library for PHP utilizing FFI, OpenBLAS, and zero-copy memory operations.",
    "keywords": [
        "machine-learning",
        "php",
        "ffi",
        "openblas",
        "scikit-learn",
        "deep-learning",
        "neural-networks",
        "xgboost",
        "svm",
        "tensor",
        "data-science"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Shubham Chaudhary",
            "email": "ghost.jat@gmai.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpbench/phpbench": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "PML\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PML\\Tests\\": "tests/",
            "PML\\Benchmarks\\": "benchmarks/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "bench": "phpbench run --report=aggregate"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require": {
    "php": "^8.1",
    "ext-ffi": "*"
  }
}